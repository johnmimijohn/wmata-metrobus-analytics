    <worksheet name='Fragility Levels'>
      <layout-options>
        <title>
          <formatted-text>
            <run>What is the level of service fragility( measured by the percentage of operational revenue miles consumed by non-revenue Deadhead miles), for Commuter, Coverage and Framework lines?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Metro.Line+ (BUDT703_Project_0506_11)' name='federated.1syen4l0vuyijm1c0dwbv1sbed1x' />
          </datasources>
          <datasource-dependencies datasource='federated.1syen4l0vuyijm1c0dwbv1sbed1x'>
            <column caption='DeadheadMiles2' datatype='real' name='[Calculation_577305187122659331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*SUM([operationalDeadheadMiles])/SUM([operationalDeadheadMiles]+[operationalRevenueMiles])' />
            </column>
