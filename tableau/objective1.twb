    <worksheet name='Social Value'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>What is the social value for each line classification class and tier?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Metro.Time+ (BUDT703_Project_0506_11)' name='federated.0s8d85y11zdgcd179nbgx1rhl9r0' />
          </datasources>
          <datasource-dependencies datasource='federated.0s8d85y11zdgcd179nbgx1rhl9r0'>
            <column caption='Social Value %' datatype='real' name='[Calculation_522417566342279168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([operationalPopLowInc]) / SUM([operationalAnnualCost])) * 100' />
            </column>
            <column caption='Classification Class' datatype='string' name='[classificationClass]' role='dimension' type='nominal' />
            <column caption='Classification Tier' datatype='string' name='[classificationTier]' role='dimension' type='nominal' />
