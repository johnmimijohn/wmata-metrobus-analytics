      <column caption='Rank Value' datatype='boolean' name='[Calculation_311592813385928705]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_DENSE( AVG([Calculation_649644260345950215]), &apos;desc&apos; ) &lt;= 5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Social Value %' datatype='real' name='[Calculation_522417566342279168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([operationalPopLowInc]) / SUM([operationalAnnualCost])) * 100' />
      </column>
      <column caption='FY2023 Cost' datatype='real' name='[Calculation_522417566342836225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [timeFiscalYear] = &apos;2023&apos; THEN [linePerformanceCostRecovery] END' />
      </column>
      <column caption='FY2024 Cost' datatype='real' name='[Calculation_522417566343045122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [timeFiscalYear] = &apos;2024&apos; THEN [linePerformanceCostRecovery] END' />
      </column>
      <column caption='Change in Cost Recovery' datatype='real' name='[Calculation_522417566343155715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_522417566343045122]) - SUM([Calculation_522417566342836225])' />
      </column>
      <column caption='Amenity Score' datatype='real' name='[Calculation_522417566343614468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[operationalPctShelters] + [operationalPctBenches]' />
      </column>
      <column caption='Total Amenities' datatype='real' name='[Calculation_522417566344503301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[operationalPctShelters] + [operationalPctBenches]' />
      </column>
      <column caption='Total Riders' datatype='integer' name='[Calculation_522417566344617990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([routePerformanceAvgDailyRidership])' />
      </column>
      <column caption='Average Cost Recovery' datatype='real' name='[Calculation_649644260341223424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([linePerformanceCostRecovery])' />
      </column>
      <column caption='Cost Recovery 2022' datatype='real' name='[Calculation_649644260341379073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [timeFiscalYear] = &quot;2022&quot; THEN [linePerformanceCostRecovery] END' />
      </column>
      <column caption='Cost Recovery 2023' datatype='real' name='[Calculation_649644260341710850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [timeFiscalYear] = &quot;2023&quot; THEN [linePerformanceCostRecovery] END' />
      </column>
      <column caption='Cost Recovery 2024' datatype='real' name='[Calculation_649644260341858307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [timeFiscalYear] = &quot;2024&quot; THEN [linePerformanceCostRecovery] END' />
      </column>
      <column caption='Change 2022-&gt;2023' datatype='real' name='[Calculation_649644260342009860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_649644260341710850]) - AVG([Calculation_649644260341379073])' />
      </column>
      <column caption='Change 2023-&gt;2024' datatype='real' name='[Calculation_649644260342083589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_649644260341858307]) - AVG([Calculation_649644260341710850])' />
      </column>
      <column caption='Year' datatype='string' name='[Calculation_649644260345774086]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([Calculation_649644260341379073]) THEN &quot;2022&quot;&#13;&#10;ELSEIF NOT ISNULL([Calculation_649644260341710850]) THEN &quot;2023&quot;&#13;&#10;ELSE &quot;2024&quot; END' />
      </column>
      <column caption='Cost Recovery' datatype='real' name='[Calculation_649644260345950215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_649644260345774086] = &quot;2022&quot; THEN [Calculation_649644260341379073]&#13;&#10;ELSEIF [Calculation_649644260345774086] = &quot;2023&quot; THEN [Calculation_649644260341710850]&#13;&#10;ELSE [Calculation_649644260341858307] END' />
      </column>
      <column caption='Average Population' datatype='real' name='[Calculation_649644260349607945]' role='measure' type='quantitative'>
