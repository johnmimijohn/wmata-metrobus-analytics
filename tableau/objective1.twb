            <column caption='Cost Recovery 2022' datatype='real' name='[Calculation_649644260341379073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [timeFiscalYear] = &quot;2022&quot; THEN [linePerformanceCostRecovery] END' />
            </column>
            <column caption='Cost Recovery 2023' datatype='real' name='[Calculation_649644260341710850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [timeFiscalYear] = &quot;2023&quot; THEN [linePerformanceCostRecovery] END' />
            </column>
            <column caption='Cost Recovery 2024' datatype='real' name='[Calculation_649644260341858307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [timeFiscalYear] = &quot;2024&quot; THEN [linePerformanceCostRecovery] END' />
            </column>
            <column caption='Year' datatype='string' name='[Calculation_649644260345774086]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([Calculation_649644260341379073]) THEN &quot;2022&quot;&#13;&#10;ELSEIF NOT ISNULL([Calculation_649644260341710850]) THEN &quot;2023&quot;&#13;&#10;ELSE &quot;2024&quot; END' />
            </column>
            <column caption='Cost Recovery' datatype='real' name='[Calculation_649644260345950215]' role='measure' type='quantitative'>
