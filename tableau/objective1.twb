            <column caption='Operational Annual Cost' datatype='real' name='[operationalAnnualCost]' role='measure' type='quantitative' />
            <column caption='Operational Pop Low Inc' datatype='integer' name='[operationalPopLowInc]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_522417566342279168]' derivation='User' name='[usr:Calculation_522417566342279168:qk]' pivot='key' type='quantitative' />
