      <aliases enabled='yes' />
      <column caption='Vehicles Per 1000 People' datatype='real' name='[Calculation_863002292715130880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([operationalPeakVehicles])/SUM([operationalPopulation]))*1000' />
      </column>
      <column caption='Mismatch Ratio' datatype='real' name='[Calculation_863002292722921473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([linePerformanceCrowding])/([linePerformanceCostRecovery])' />
      </column>
      <column caption='Weekday Cost' datatype='real' name='[Calculation_863002292736630786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [timeDayType (Metro.Time3)]=&apos;Weekday&apos;&#13;&#10;THEN [linePerformanceOpsCostperPAX]&#13;&#10;END' />
      </column>
      <column caption='Weekend Cost' datatype='real' name='[Calculation_863002292737212419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [timeDayType (Metro.Time3)]=&apos;Saturday&apos; OR [timeDayType (Metro.Time3)]=&apos;Sunday&apos;&#13;&#10;THEN [linePerformanceOpsCostperPAX]&#13;&#10;END' />
      </column>
      <column caption='Weekend Surcharge' datatype='real' name='[Calculation_863002292737478660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_863002292737212419]) - AVG([Calculation_863002292736630786])' />
      </column>
      <column caption='Day_Group' datatype='string' name='[Calculation_863002292740141061]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [timeDayType (Metro.Time3)]= &apos;Weekday&apos; THEN &apos;Weekday Cost&apos;&#13;&#10;ELSEIF [timeDayType (Metro.Time3)] = &apos;Saturday&apos; OR [timeDayType (Metro.Time3)] = &apos;Sunday&apos; THEN &apos;Weekend Cost&apos;&#13;&#10;END' />
      </column>
      <column caption='Avg Daily Ridership' datatype='integer' name='[Calculation_863002292742754310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([routePerformanceAvgDailyRidership])' />
      </column>
      <column caption='Peak Vehicles' datatype='integer' name='[Calculation_863002292743499783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([operationalPeakVehicles])' />
      </column>
      <column caption='Ridership Share (%)' datatype='real' name='[Calculation_863002292743622664]' role='measure' type='quantitative'>
