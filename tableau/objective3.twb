    <worksheet name='Crowding vs. Cost'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='11'>Which lines consistently exhibit high crowding (demand) but low cost recovery (financial return) over time?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Metro.Classification+ (BUDT703_Project_0506_11)' name='federated.03k7c7o0pz0dk31eoymw41ycpt8s' />
          </datasources>
          <datasource-dependencies datasource='federated.03k7c7o0pz0dk31eoymw41ycpt8s'>
            <column caption='Mismatch Ratio' datatype='real' name='[Calculation_863002292722921473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([linePerformanceCrowding])/([linePerformanceCostRecovery])' />
            </column>
            <column-instance column='[Calculation_863002292722921473]' derivation='Avg' name='[avg:Calculation_863002292722921473:qk]' pivot='key' type='quantitative' />
            <column caption='Line Name' datatype='string' name='[lineName]' role='dimension' type='nominal' />
            <column caption='Line Performance Cost Recovery' datatype='real' name='[linePerformanceCostRecovery]' role='measure' type='quantitative' />
            <column caption='Line Performance Crowding' datatype='real' name='[linePerformanceCrowding]' role='measure' type='quantitative' />
            <column-instance column='[lineName]' derivation='None' name='[none:lineName:nk]' pivot='key' type='nominal' />
            <column-instance column='[linePerformanceCrowding]' derivation='None' name='[none:linePerformanceCrowding:qk]' pivot='key' type='quantitative' />
            <column-instance column='[timeFiscalYear (Metro.Time3)]' derivation='None' name='[none:timeFiscalYear (Metro.Time3):nk]' pivot='key' type='nominal' />
