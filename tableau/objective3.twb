    <worksheet name='Service Trade-offs'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='11'>Which Jurisdictions and Service Types maximize ridership crowding while minimizing operating costs during Weekday  for most recent Fiscal Year?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Metro.Classification+ (BUDT703_Project_0506_11)' name='federated.03k7c7o0pz0dk31eoymw41ycpt8s' />
          </datasources>
          <datasource-dependencies datasource='federated.03k7c7o0pz0dk31eoymw41ycpt8s'>
            <column caption='Day_Group' datatype='string' name='[Calculation_863002292740141061]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [timeDayType (Metro.Time3)]= &apos;Weekday&apos; THEN &apos;Weekday Cost&apos;&#13;&#10;ELSEIF [timeDayType (Metro.Time3)] = &apos;Saturday&apos; OR [timeDayType (Metro.Time3)] = &apos;Sunday&apos; THEN &apos;Weekend Cost&apos;&#13;&#10;END' />
            </column>
            <column caption='Max Crowding (%)' datatype='real' name='[Calculation_863002292748476428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([linePerformanceCrowding]) * 100' />
            </column>
            <column caption='Metro.Line' datatype='table' name='[__tableau_internal_object_id__].[Metro.Line_0E508C77974146C080BF89D68AED15BF]' role='measure' type='quantitative' />
            <column-instance column='[__tableau_internal_object_id__].[Metro.Line_0E508C77974146C080BF89D68AED15BF]' derivation='Count' name='[__tableau_internal_object_id__].[cnt:Metro.Line_0E508C77974146C080BF89D68AED15BF:qk]' pivot='key' type='quantitative' />
            <column-instance column='[linePerformanceCrowding]' derivation='Avg' name='[avg:linePerformanceCrowding:qk]' pivot='key' type='quantitative' />
            <column-instance column='[linePerformanceOpsCostperPAX]' derivation='Avg' name='[avg:linePerformanceOpsCostperPAX:qk]' pivot='key' type='quantitative' />
            <column caption='Classification Class' datatype='string' name='[classificationClass]' role='dimension' type='nominal' />
            <column caption='Line Jurisdiction' datatype='string' name='[lineJurisdiction]' role='dimension' type='nominal' />
            <column caption='Line Performance Crowding' datatype='real' name='[linePerformanceCrowding]' role='measure' type='quantitative' />
