          <computed-sort column='[federated.03k7c7o0pz0dk31eoymw41ycpt8s].[none:lineName:nk]' direction='DESC' using='[federated.03k7c7o0pz0dk31eoymw41ycpt8s].[avg:Calculation_863002292722921473:qk]' />
