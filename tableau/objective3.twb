  <worksheets>
    <worksheet name='Cost Efficiency Gap'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='11'>How does the Operating Cost per Passenger increase on Weekends compared to Weekdays YoY for Framework lines?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Metro.Classification+ (BUDT703_Project_0506_11)' name='federated.03k7c7o0pz0dk31eoymw41ycpt8s' />
          </datasources>
          <datasource-dependencies datasource='federated.03k7c7o0pz0dk31eoymw41ycpt8s'>
            <column caption='Day_Group' datatype='string' name='[Calculation_863002292740141061]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [timeDayType (Metro.Time3)]= &apos;Weekday&apos; THEN &apos;Weekday Cost&apos;&#13;&#10;ELSEIF [timeDayType (Metro.Time3)] = &apos;Saturday&apos; OR [timeDayType (Metro.Time3)] = &apos;Sunday&apos; THEN &apos;Weekend Cost&apos;&#13;&#10;END' />
            </column>
            <column-instance column='[linePerformanceOpsCostperPAX]' derivation='Avg' name='[avg:linePerformanceOpsCostperPAX:qk]' pivot='key' type='quantitative' />
            <column caption='Classification Class' datatype='string' name='[classificationClass]' role='dimension' type='nominal' />
            <column caption='Line Name' datatype='string' name='[lineName]' role='dimension' type='nominal' />
            <column caption='Line Performance Ops Costper PAX' datatype='real' name='[linePerformanceOpsCostperPAX]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_863002292740141061]' derivation='None' name='[none:Calculation_863002292740141061:nk]' pivot='key' type='nominal' />
            <column-instance column='[classificationClass]' derivation='None' name='[none:classificationClass:nk]' pivot='key' type='nominal' />
            <column-instance column='[lineName]' derivation='None' name='[none:lineName:nk]' pivot='key' type='nominal' />
            <column-instance column='[timeFiscalYear (Metro.Time3)]' derivation='None' name='[none:timeFiscalYear (Metro.Time3):nk]' pivot='key' type='nominal' />
            <column caption='Day Type_' datatype='string' name='[timeDayType (Metro.Time3)]' role='dimension' type='nominal' />
            <column caption='Fiscal Year ' datatype='string' name='[timeFiscalYear (Metro.Time3)]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.03k7c7o0pz0dk31eoymw41ycpt8s].[none:classificationClass:nk]'>
            <groupfilter function='member' level='[none:classificationClass:nk]' member='&quot;Framework&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.03k7c7o0pz0dk31eoymw41ycpt8s].[none:lineName:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.03k7c7o0pz0dk31eoymw41ycpt8s].[avg:linePerformanceOpsCostperPAX:qk]' shelf='rows'>
              <sort-filter-info>
                <sort-filter level-name='[federated.03k7c7o0pz0dk31eoymw41ycpt8s].[none:timeFiscalYear (Metro.Time3):nk]' member-value='&quot;2023&quot;' />
              </sort-filter-info>
            </shelf-sort-v2>
          </shelf-sorts>
          <slices>
            <column>[federated.03k7c7o0pz0dk31eoymw41ycpt8s].[none:classificationClass:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
